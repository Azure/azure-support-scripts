{
  "name": "rca-tool",
  "displayName": "RCA Tool",
  "description": "Analyze Linux support archives (sosreport / supportconfig) directly from VS Code Chat via the RCA Tool MCP server.",
  "version": "0.1.0",
  "publisher": "azure-support-scripts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Azure/azure-support-scripts.git",
    "directory": "rca-tool/vscode-extension"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "mcp",
    "rca",
    "sosreport",
    "supportconfig",
    "azure"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onMcpCollection:rca-tool"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "rca-tool",
        "label": "RCA Tool"
      }
    ],
    "configuration": {
      "title": "RCA Tool",
      "properties": {
        "rcaTool.mcpServerPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to a `supportfile_mcp` binary to use instead of the one bundled with the extension. Leave empty to use the bundled binary."
        },
        "rcaTool.rcaCliPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to an `rca_cli` binary to use instead of the one bundled with the extension. Leave empty to use the bundled binary (exposed to the server via `RCA_CLI_BIN`)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.101.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
